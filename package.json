{
  "name": "koes",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "turbo clean",
    "prepare": "lefthook install",
    "fmt": "oxfmt",
    "lint": "effect-tsgo --tsrs-lint oxlint",
    "check": "effect-tsgo --tsrs-lint oxlint && oxfmt --check",
    "typecheck": "turbo typecheck",
    "fallow": "fallow",
    "fallow:health": "fallow health --format human",
    "dev": "turbo dev",
    "build": "turbo build",
    "deploy": "turbo run deploy"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@effect/tsgo": "0.73.4",
    "@types/node": "catalog:",
    "fallow": "3.46.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "renovate": "44.257.9",
    "tsrs": "7.1.0-beta.tsrs4",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "ultracite": "8.3.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "24.22.3"
  },
  "packageManager": "pnpm@12.21.0"
}
